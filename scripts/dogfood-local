#!/usr/bin/env bash
set -euo pipefail

SOURCE_ROOT=$(git rev-parse --show-toplevel)
SOURCE_SHA=$(git -C "$SOURCE_ROOT" rev-parse HEAD)
DOGFOOD_DIR=$(mktemp -d /tmp/kaji-ts-dogfood.XXXXXX)

cleanup() {
  if [[ "$DOGFOOD_DIR" == /tmp/kaji-ts-dogfood.* ]]; then
    rm -rf -- "$DOGFOOD_DIR"
  fi
}
trap cleanup EXIT

git clone --no-local "$SOURCE_ROOT" "$DOGFOOD_DIR/repository"
cd "$DOGFOOD_DIR/repository"
make setup
unshare --user --map-root-user --net make check
./scripts/kaji local init --machine-id dogfood --non-interactive
npm run set-agent -- codex
git add .kaji/wf/custom
git commit -m "chore: select Codex for local dogfood"

ISSUE_BODY="$DOGFOOD_DIR/issue.md"
cat >"$ISSUE_BODY" <<'EOF'
## 概要

Add a pure `formatGreeting(name)` helper and use it from the sample app.
This intentionally changes the public default stdout from
`Hello from starter-app!` to `Hello, starter-app!`; update the documented
default and tests to match. Configured `APP_MESSAGE` output remains unchanged.

## スコープ境界

Include the helper, tagged tests, and related docs only.

## 完了条件

- [ ] `formatGreeting("Codex")` returns `Hello, Codex!`
- [ ] the default stdout and configuration reference are `Hello, starter-app!`
- [ ] configured `APP_MESSAGE` values still pass through unchanged
- [ ] `make check` passes
EOF

ISSUE_ID=$(./scripts/kaji issue create \
  --title "feat: exercise TypeScript starter lifecycle" \
  --body-file "$ISSUE_BODY" \
  --label type:feature)

DOGFOOD_AGENT=${KAJI_DOGFOOD_AGENT:-codex}
START_PROMPT="Read and execute .claude/skills/issue-start/SKILL.md for issue ${ISSUE_ID}. Complete only issue-start, including worktree-local make setup and the required Issue report."
case "$DOGFOOD_AGENT" in
  codex)
    DOGFOOD_CODEX=${KAJI_DOGFOOD_CODEX:-$(command -v codex || true)}
    if [[ -z "$DOGFOOD_CODEX" ]]; then
      printf 'codex executable not found; set KAJI_DOGFOOD_CODEX\n' >&2
      exit 127
    fi
    mkdir -p "$DOGFOOD_DIR/agent-bin"
    ln -s "$DOGFOOD_CODEX" "$DOGFOOD_DIR/agent-bin/codex"
    export PATH="$DOGFOOD_DIR/agent-bin:$PATH"
    codex exec \
      --cd "$PWD" \
      --dangerously-bypass-approvals-and-sandbox \
      --ephemeral \
      "$START_PROMPT"
    ;;
  claude)
    DOGFOOD_CLAUDE=${KAJI_DOGFOOD_CLAUDE:-$(command -v claude || true)}
    if [[ -z "$DOGFOOD_CLAUDE" ]]; then
      printf 'claude executable not found; set KAJI_DOGFOOD_CLAUDE\n' >&2
      exit 127
    fi
    mkdir -p "$DOGFOOD_DIR/agent-bin"
    ln -s "$DOGFOOD_CLAUDE" "$DOGFOOD_DIR/agent-bin/claude"
    export PATH="$DOGFOOD_DIR/agent-bin:$PATH"
    claude --print \
      --permission-mode bypassPermissions \
      "$START_PROMPT"
    ;;
  *)
    printf 'Unsupported KAJI_DOGFOOD_AGENT: %s\n' "$DOGFOOD_AGENT" >&2
    exit 2
    ;;
esac

BRANCH=$(./scripts/kaji issue context "$ISSUE_ID" -q '.branch_name')
WORKTREE=$(./scripts/kaji issue context "$ISSUE_ID" -q '.worktree_dir')
test -d "$WORKTREE/node_modules"
test -d "$WORKTREE/tools/kaji/.venv"
test -x "$WORKTREE/.tools/actionlint"
test ! -L "$WORKTREE/node_modules"
test ! -L "$WORKTREE/tools/kaji/.venv"
test ! -L "$WORKTREE/.tools"
if script --version 2>&1 | grep -q "util-linux"; then
  script -qec \
    "./scripts/kaji run .kaji/wf/custom/local/dev-local.yaml $ISSUE_ID" \
    /dev/null
else
  script -q /dev/null \
    ./scripts/kaji run .kaji/wf/custom/local/dev-local.yaml "$ISSUE_ID"
fi

git diff --exit-code
test -z "$(git status --short)"
test ! -e "$WORKTREE"
ISSUE_OUTPUT=$(./scripts/kaji issue view "$ISSUE_ID" --comments)
grep -q "TypeScript Baseline" <<<"$ISSUE_OUTPUT"
grep -q "status: PASS" <<<"$ISSUE_OUTPUT"
test "$(./scripts/kaji issue view "$ISSUE_ID" --json state -q '.state')" = "closed"
printf 'dogfood_source_sha=%s\n' "$SOURCE_SHA"
printf 'dogfood_issue=%s\n' "$ISSUE_ID"
printf 'dogfood_issue_start_agent=%s\n' "$DOGFOOD_AGENT"
printf 'dogfood_baseline=PASS\n'
printf 'dogfood_close=PASS\n'
printf 'dogfood_source_clean=PASS\n'
