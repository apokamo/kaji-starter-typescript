#!/usr/bin/env bash
set -euo pipefail
if [[ "$#" -eq 1 && "$1" == "validate" ]]; then
  workflows=()
  while IFS= read -r workflow; do
    workflows+=("$workflow")
  done < <(find .kaji/wf/custom -type f -name '*.yaml' -print | sort)
  exec uv run --project tools/kaji --locked --offline kaji validate "${workflows[@]}"
fi
if [[ "$#" -ge 1 && "$1" == "series-generate" ]]; then
  shift
  exec uv run --project tools/kaji --locked --offline \
    python -m kaji_harness.scripts.series_generate "$@"
fi
exec uv run --project tools/kaji --locked --offline kaji "$@"
